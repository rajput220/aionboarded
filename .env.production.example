# ===========================================
# AI Onboarded — Production Environment
# ===========================================
# Copy this file to .env.production and fill in real values
# NEVER commit .env.production to Git!

# Database (used by docker-compose.prod.yml)
POSTGRES_USER=aionboarded
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=aionboarded
DATABASE_URL=postgres://aionboarded:CHANGE_ME_TO_A_STRONG_PASSWORD@postgres:5432/aionboarded

# Payload CMS (generate with: openssl rand -hex 32)
PAYLOAD_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# Site
NEXT_PUBLIC_SITE_URL=https://aionboarded.ai
NEXT_PUBLIC_SITE_NAME=AI Onboarded

# Newsletter (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Optional: S3 for media uploads in production
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
